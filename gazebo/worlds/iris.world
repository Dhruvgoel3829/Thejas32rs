<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- 1. Sun & Ground Plane -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- 2. Iris Quadcopter Model -->
    <model name="iris">
      <pose>0 0 0.2 0 0 0</pose>

      <!-- ROOT LINK: Central Body -->
      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.0347563</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0458929</iyy>
            <iyz>0</iyz>
            <izz>0.0977</izz>
          </inertia>
        </inertial>

        <!-- Central body visual - carbon fiber look -->
        <visual name="body_visual">
          <geometry>
            <box>
              <size>0.12 0.12 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>

        <!-- Battery compartment visual -->
        <visual name="battery_visual">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.08 0.05 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Flight controller board visual -->
        <visual name="fc_visual">
          <pose>0 0 0.055 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.04 0.008</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.1 0.05 1</ambient>
            <diffuse>0.1 0.25 0.1 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>

        <!-- Physical collision box -->
        <collision name="body_collision">
          <geometry>
            <box>
              <size>0.12 0.12 0.06</size>
            </box>
          </geometry>
        </collision>

        <!-- Built-in Gazebo IMU Sensor -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>250</update_rate>
          <visualize>true</visualize>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- ARM 0: Rear Right (extends to rotor 0) -->
      <link name="arm_0">
        <pose>0.06 -0.06 0.015 0 0 0.785398</pose>  <!-- 45 deg -->
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.000015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00012</iyy><iyz>0</iyz>
            <izz>0.000135</izz>
          </inertia>
        </inertial>
        <visual name="arm_0_visual">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.25 0.25 0.3 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <collision name="arm_0_collision">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
        </collision>
      </link>
      <joint name="arm_0_joint" type="fixed">
        <parent>base_link</parent>
        <child>arm_0</child>
      </joint>

      <!-- ARM 1: Front Right -->
      <link name="arm_1">
        <pose>-0.06 0.06 0.015 0 0 -0.785398</pose>  <!-- -45 deg -->
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.000015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00012</iyy><iyz>0</iyz>
            <izz>0.000135</izz>
          </inertia>
        </inertial>
        <visual name="arm_1_visual">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.25 0.25 0.3 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <collision name="arm_1_collision">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
        </collision>
      </link>
      <joint name="arm_1_joint" type="fixed">
        <parent>base_link</parent>
        <child>arm_1</child>
      </joint>

      <!-- ARM 2: Rear Left -->
      <link name="arm_2">
        <pose>0.06 0.06 0.015 0 0 2.35619</pose>  <!-- 135 deg -->
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.000015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00012</iyy><iyz>0</iyz>
            <izz>0.000135</izz>
          </inertia>
        </inertial>
        <visual name="arm_2_visual">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.25 0.25 0.3 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <collision name="arm_2_collision">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
        </collision>
      </link>
      <joint name="arm_2_joint" type="fixed">
        <parent>base_link</parent>
        <child>arm_2</child>
      </joint>

      <!-- ARM 3: Front Left -->
      <link name="arm_3">
        <pose>-0.06 -0.06 0.015 0 0 -2.35619</pose>  <!-- -135 deg -->
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.000015</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00012</iyy><iyz>0</iyz>
            <izz>0.000135</izz>
          </inertia>
        </inertial>
        <visual name="arm_3_visual">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.25 0.25 0.3 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <collision name="arm_3_collision">
          <geometry>
            <cylinder><radius>0.01</radius><length>0.24</length></cylinder>
          </geometry>
        </collision>
      </link>
      <joint name="arm_3_joint" type="fixed">
        <parent>base_link</parent>
        <child>arm_3</child>
      </joint>

      <!-- ROTOR 0: Rear Right (CW) - Blue prop tips -->
      <link name="rotor_0">
        <pose>0.18 -0.18 0.035 0 0 0</pose>
        <inertial>
          <mass>0.008</mass>
          <inertia>
            <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0005</iyy><iyz>0</iyz>
            <izz>0.0005015</izz>
          </inertia>
        </inertial>
        <visual name="rotor_0_visual">
          <geometry>
            <cylinder><radius>0.11</radius><length>0.006</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.18 1</ambient>
            <diffuse>0.3 0.3 0.4 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
        <!-- Blue tip markers -->
        <visual name="rotor_0_tip1">
          <pose>0.085 0 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.05 0.015 0.004</size></box>
          </geometry>
          <material>
            <ambient>0 0.2 0.8 1</ambient>
            <diffuse>0 0.5 1 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
            <emissive>0.2 0.4 0.8 1</emissive>
          </material>
        </visual>
        <visual name="rotor_0_tip2">
          <pose>-0.085 0 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.05 0.015 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <parent>arm_0</parent>
        <child>rotor_0</child>
        <pose>0.12 -0.12 0.02 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
          <dynamics>
            <damping>0.001</damping>
            <friction>0.0001</friction>
          </dynamics>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>

      <!-- ROTOR 1: Front Right (CCW) - Red prop tips -->
      <link name="rotor_1">
        <pose>-0.18 0.18 0.035 0 0 0</pose>
        <inertial>
          <mass>0.008</mass>
          <inertia>
            <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0005</iyy><iyz>0</iyz>
            <izz>0.0005015</izz>
          </inertia>
        </inertial>
        <visual name="rotor_1_visual">
          <geometry>
            <cylinder><radius>0.11</radius><length>0.006</length></cylinder>
          </geometry>
          <material>
            <ambient>0.18 0.12 0.12 1</ambient>
            <diffuse>0.4 0.25 0.25 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
        <visual name="rotor_1_tip1">
          <pose>0 0.085 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.015 0.05 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
            <emissive>0.8 0.2 0.2 1</emissive>
          </material>
        </visual>
        <visual name="rotor_1_tip2">
          <pose>0 -0.085 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.015 0.05 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <parent>arm_1</parent>
        <child>rotor_1</child>
        <pose>-0.12 0.12 0.02 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
          <dynamics>
            <damping>0.001</damping>
            <friction>0.0001</friction>
          </dynamics>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>

      <!-- ROTOR 2: Rear Left (CCW) - Green prop tips -->
      <link name="rotor_2">
        <pose>0.18 0.18 0.035 0 0 0</pose>
        <inertial>
          <mass>0.008</mass>
          <inertia>
            <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0005</iyy><iyz>0</iyz>
            <izz>0.0005015</izz>
          </inertia>
        </inertial>
        <visual name="rotor_2_visual">
          <geometry>
            <cylinder><radius>0.11</radius><length>0.006</length></cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.18 0.12 1</ambient>
            <diffuse>0.25 0.4 0.25 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
        <visual name="rotor_2_tip1">
          <pose>-0.085 0 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.05 0.015 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 1 0.2 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
            <emissive>0.2 0.8 0.2 1</emissive>
          </material>
        </visual>
        <visual name="rotor_2_tip2">
          <pose>0.085 0 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.05 0.015 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <parent>arm_2</parent>
        <child>rotor_2</child>
        <pose>0.12 0.12 0.02 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
          <dynamics>
            <damping>0.001</damping>
            <friction>0.0001</friction>
          </dynamics>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>

      <!-- ROTOR 3: Front Left (CW) - Orange prop tips -->
      <link name="rotor_3">
        <pose>-0.18 -0.18 0.035 0 0 0</pose>
        <inertial>
          <mass>0.008</mass>
          <inertia>
            <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0005</iyy><iyz>0</iyz>
            <izz>0.0005015</izz>
          </inertia>
        </inertial>
        <visual name="rotor_3_visual">
          <geometry>
            <cylinder><radius>0.11</radius><length>0.006</length></cylinder>
          </geometry>
          <material>
            <ambient>0.18 0.15 0.1 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
        <visual name="rotor_3_tip1">
          <pose>0 -0.085 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.015 0.05 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.5 0.1 1</ambient>
            <diffuse>1 0.6 0.1 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
            <emissive>0.8 0.5 0.1 1</emissive>
          </material>
        </visual>
        <visual name="rotor_3_tip2">
          <pose>0 0.085 0.002 0 0 0</pose>
          <geometry>
            <box><size>0.015 0.05 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <parent>arm_3</parent>
        <child>rotor_3</child>
        <pose>-0.12 -0.12 0.02 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
          <dynamics>
            <damping>0.001</damping>
            <friction>0.0001</friction>
          </dynamics>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>

      <plugin name="thejas_sitl" filename="libthejas_sitl.so"/>

    </model>
  </world>
</sdf>