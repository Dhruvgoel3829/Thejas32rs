<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- 1. Sun & Ground Plane -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 2. Iris Quadcopter Model -->
    <model name="iris">
      <pose>0 0 0.2 0 0 0</pose>

      <!-- ROOT LINK: Base Chassis -->
      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.0347563</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0458929</iyy>
            <iyz>0</iyz>
            <izz>0.0977</izz>
          </inertia>
        </inertial>

        <!-- Visual representation of fuselage -->
        <visual name="base_link_visual">
          <geometry>
            <box>
              <size>0.47 0.47 0.11</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <!-- Physical collision box -->
        <collision name="base_link_collision">
          <geometry>
            <box>
              <size>0.47 0.47 0.11</size>
            </box>
          </geometry>
        </collision>

        <!-- Built-in Gazebo IMU Sensor (Attached to root base_link) -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>250</update_rate>
          <visualize>true</visualize>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- ROTOR 0: Rear Right (CW) -->
      <link name="rotor_0">
        <pose>0.13 -0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_0_visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.005</length></cylinder>
          </geometry>
          <material><ambient>0 0 1 1</ambient></material>
        </visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_0</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- ROTOR 1: Front Right (CCW) -->
      <link name="rotor_1">
        <pose>-0.13 0.2 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_1_visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.005</length></cylinder>
          </geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_1</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- ROTOR 2: Rear Left (CCW) -->
      <link name="rotor_2">
        <pose>0.13 0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_2_visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.005</length></cylinder>
          </geometry>
          <material><ambient>0 0 1 1</ambient></material>
        </visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_2</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- ROTOR 3: Front Left (CW) -->
      <link name="rotor_3">
        <pose>-0.13 -0.2 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_3_visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>0.005</length></cylinder>
          </geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_3</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

    </model>
  </world>
</sdf>